// Schéma Prisma OmniLearning (Option C, fondation backend)
// Adapté de l'ancienne codebase (Next.js 14), voir prisma/schema.sqlite.prisma d'origine.
// Provider SQLite en dev (zéro setup), Postgres en prod via DATABASE_URL.
// SQLite ne supporte ni enums, ni Json natif, ni String[] : on stocke en String/JSON-string.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Prisma 7 : l'URL n'est plus ici mais dans prisma.config.ts (migrations) et
  // via un driver adapter passé au PrismaClient (runtime). Voir src/lib/db.ts.
  // En prod : passer provider="postgresql".
  provider = "sqlite"
}

// ----- Auth.js / NextAuth (adapter Prisma) -----

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String? // hash bcrypt ; null pour comptes OAuth
  name          String?
  image         String?
  // USER (étudiant) | INSTRUCTOR (formateur) | ADMIN
  role          String    @default("USER")
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  enrollments   Enrollment[]
  courses       Course[]       @relation("InstructorCourses")
  drafts        CourseDraft[]
  quizAttempts  QuizAttempt[]
  subscriptions Subscription[]
  xpEvents      XpEvent[]
  stats         UserStats?
  userBadges    UserBadge[]
  reviews       Review[]
  purchases     Purchase[]
  instructorProfile InstructorProfile?
  lessonComments LessonComment[]
  lessonNotes    LessonNote[]

  // ID client Stripe (pour le portail + abonnements)
  stripeCustomerId String? @unique

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ----- Catalogue de formations -----

model Category {
  id      String   @id @default(cuid())
  // Identifiant stable utilisé dans l'UI (ex: "dev-web")
  slug    String   @unique
  label   String
  icon    String
  courses Course[]

  @@index([slug])
}

model Course {
  id               String  @id @default(cuid())
  slug             String  @unique
  title            String
  tagline          String
  description      String
  category         String
  level            String  @default("Débutant") // Débutant | Intermédiaire | Avancé
  instructorName   String
  instructorBio    String?
  hours            Int     @default(0)
  rating           Float   @default(0)
  learners         Int     @default(0)
  accent           String  @default("#215775")
  image            String
  language         String?
  software         String?
  // Listes sérialisées en JSON-string (SQLite)
  prerequisites    String?
  summary          String?
  objectives       String?
  skills           String?
  contentTypes     String?
  // Traductions (en, ar) sérialisées en JSON-string : { en: {title,tagline,...}, ar: {...} }
  i18n             String?
  status           String  @default("PUBLISHED") // DRAFT | PUBLISHED | ARCHIVED
  // ----- Monétisation -----
  // FREE : accès dès l'inscription. PAID : achat unique requis (priceCents > 0).
  accessType       String  @default("FREE")
  // Prix TTC en centimes, dans la devise ci-dessous. 0 tant que FREE.
  priceCents       Int     @default(0)
  currency         String  @default("usd")
  // Part reversée au formateur, en % du montant encaissé (le reste = commission
  // plateforme). Figée à la publication : changer le barème ne réécrit pas les
  // ventes déjà faites, chaque Purchase garde son propre découpage.
  revenueSharePct  Int     @default(70)
  // Horodatage du prix d'amorçage. Non nul = le tarif a déjà été posé une fois,
  // le seed n'y retouche plus jamais : un prix changé en back-office survit aux
  // déploiements suivants.
  pricingSeededAt  DateTime?
  stripeProductId  String?
  stripePriceId    String?
  // Liens optionnels vers les entités relationnelles
  instructorId     String?
  categoryId       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  instructor   User?         @relation("InstructorCourses", fields: [instructorId], references: [id])
  categoryRel  Category?     @relation(fields: [categoryId], references: [id])
  parts        CoursePart[]
  enrollments  Enrollment[]
  reviews      Review[]
  purchases    Purchase[]
  pathLinks    LearningPathCourse[]

  @@index([slug])
  @@index([status])
  @@index([accessType])
}

model CoursePart {
  id       String   @id @default(cuid())
  courseId String
  title    String
  order    Int      @default(0)
  createdAt DateTime @default(now())

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId])
}

model Lesson {
  id          String  @id @default(cuid())
  partId      String
  // Clé "métier" stable utilisée dans les URLs (ex: "l1")
  key         String
  title       String
  type        String // video | text | quiz | scorm
  duration    String
  body        String?
  videoLabel  String?
  // --- Vidéo (leçons type="video") ---
  // Source jouable : MP4 progressif ou manifeste HLS. Vide = la leçon affiche
  // son texte et une pastille "vidéo en préparation" au lieu d'un lecteur mort.
  videoUrl    String?
  // Image d'attente (16:9). Sans elle, le navigateur montre un carré noir.
  videoPoster String?
  // Durée réelle en secondes. `duration` reste l'étiquette lisible ("12 min") ;
  // celle-ci sert au lecteur et aux données structurées VideoObject.
  videoDurationSec Int?
  // Sous-titres : JSON { "fr": "/videos/x.fr.vtt", "en": "...", "ar": "..." }.
  // La plateforme est trilingue : une vidéo sans sous-titres n'est pas publiable.
  captions    String?
  // questions de quiz sérialisées en JSON-string
  questions   String?
  // Traductions (en, ar) : { en: {title, body, videoLabel, questions:[...]}, ar: {...} }
  i18n        String?
  // --- SCORM (leçons type="scorm") ---
  // Dossier du paquet décompressé sous public/uploads, ex: "scorm/<lessonId>".
  // Vide = la leçon affiche son texte au lieu d'un lecteur mort.
  scormPackagePath String?
  // Chemin de l'entrée relatif au dossier ci-dessus (depuis imsmanifest.xml), ex: "shared/launchpage.html".
  scormEntryPath   String?
  // "1.2" ou "2004" — décide quelle classe scorm-again instancier (Scorm12API / Scorm2004API).
  scormVersion     String?
  // XP attribuée à la complétion de cette leçon (défaut appliqué côté logique si 0)
  xp          Int     @default(0)
  // Accès libre sans compte (les 2 premières leçons de chaque cours au seed)
  isFree      Boolean @default(false)
  order       Int     @default(0)
  createdAt   DateTime @default(now())

  part     CoursePart       @relation(fields: [partId], references: [id], onDelete: Cascade)
  progress LessonProgress[]
  comments LessonComment[]
  notes    LessonNote[]

  @@index([partId])
}

// ----- Inscriptions & progression (liées à l'utilisateur) -----

model Enrollment {
  id             String    @id @default(cuid())
  userId         String
  courseId       String
  progress       Int       @default(0)
  lastLesson     String?
  lastAccessedAt DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonProgress LessonProgress[]

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model LessonProgress {
  id           String    @id @default(cuid())
  enrollmentId String
  lessonId     String
  isCompleted  Boolean   @default(false)
  completedAt  DateTime?
  // État "cmi" SCORM sérialisé en JSON (renderCMIToJSONString) — permet de reprendre
  // une leçon SCORM où l'apprenant l'a laissée (bookmark, score, suspend_data).
  scormData    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId])
}

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  // réponses sérialisées en JSON-string
  answers     String
  score       Int
  maxScore    Int
  isPassed    Boolean
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lessonId])
}

// ----- Création de formation (brouillon + uploads) -----

model CourseDraft {
  id           String   @id @default(cuid())
  authorId     String
  category     String?
  name         String?
  description  String?
  level        String?
  skills       String?
  prerequisites String?
  structure    String?
  // activités sérialisées en JSON-string
  activities   String?
  // URLs des fichiers uploadés (image, vidéo, ressources) en JSON-string
  uploads      String?
  // Modules et leçons saisis par le formateur, en JSON-string :
  // [{ title, lessons:[{ title, type, duration, body?, videoUrl?, questions? }] }]
  curriculum   String?
  status       String   @default("DRAFT") // DRAFT | SUBMITTED
  // Prix proposé par le formateur (centimes). L'admin tranche à la validation.
  priceCents   Int      @default(0)
  currency     String   @default("usd")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
}

// ----- Achat de formation (paiement unique) -----

// Une ligne = un droit d'accès payé. C'est ce modèle, et lui seul, qui ouvre
// une formation PAID : un compte gratuit ne déverrouille plus rien.
// Le découpage (part formateur / commission) est figé au moment de l'encaissement.
model Purchase {
  id                      String  @id @default(cuid())
  userId                  String
  courseId                String
  // pending : session ouverte, argent pas encore confirmé.
  // paid    : webhook Stripe reçu, accès ouvert.
  // refunded: remboursé, accès révoqué.
  status                  String  @default("pending")
  amountCents             Int     @default(0)
  currency                String  @default("usd")
  // Découpage figé (centimes) : ce que garde la plateforme / ce qui part au formateur.
  platformFeeCents        Int     @default(0)
  instructorAmountCents   Int     @default(0)
  // Compte Connect destinataire au moment de la vente (null = vente maison).
  instructorAccountId     String?
  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String? @unique
  paidAt                  DateTime?
  refundedAt              DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Un seul droit d'accès par couple (achat re-tenté = même ligne réutilisée).
  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([status])
}

// ----- Formateurs tiers (candidature + compte de versement Stripe Connect) -----

model InstructorProfile {
  id       String @id @default(cuid())
  userId   String @unique
  // PENDING | APPROVED | REJECTED — APPROVED bascule aussi User.role à INSTRUCTOR.
  applicationStatus String @default("PENDING")
  displayName String
  headline    String?
  bio         String?
  expertise   String?
  website     String?
  country     String  @default("FR")
  // Barème appliqué aux formations de ce formateur (% qui lui revient).
  revenueSharePct Int  @default(70)
  // ----- Stripe Connect (compte Express du formateur) -----
  stripeAccountId String? @unique
  // Recopiés depuis l'événement account.updated : tant que chargesEnabled est
  // faux, aucune vente ne peut être routée vers ce compte.
  chargesEnabled   Boolean @default(false)
  payoutsEnabled   Boolean @default(false)
  detailsSubmitted Boolean @default(false)
  reviewedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([applicationStatus])
}

// ----- Abonnements Stripe (page "soutenir") -----

model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  // soutien ($5) | mecene ($15) | partenaire ($50), prix Stripe en USD avec currency_options
  tier                 String
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  status               String    @default("incomplete") // incomplete | active | past_due | canceled
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// ----- Gamification (couche sobre, façon Brilliant : sert l'apprentissage) -----

// Journal append-only : le total d'XP se dérive par somme (jamais de compteur muté à la main).
model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  // lesson_complete | quiz_passed | course_completed | streak_bonus | badge_earned
  reason    String
  // référence libre (lessonId, courseId…) pour tracer / éviter les doublons
  refId     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, reason, refId])
}

// Cache dérivé (recalculé après chaque gain) : niveau, série, dernier jour actif.
model UserStats {
  id             String    @id @default(cuid())
  userId         String    @unique
  xp             Int       @default(0)
  level          Int       @default(1)
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveDate DateTime?
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([xp])
}

model Badge {
  id          String  @id @default(cuid())
  slug        String  @unique
  label       String
  description String
  icon        String  // clé d'icône UI (ex: "flame", "trophy")
  // condition déclarative : { type: "xp"|"streak"|"courses_completed"|"quizzes_passed", threshold: n }
  condition   String
  tier        String  @default("bronze") // bronze | argent | or
  i18n        String?

  userBadges UserBadge[]

  @@index([slug])
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
}

// ----- Avis apprenants (multilingues) -----

model Review {
  id         String   @id @default(cuid())
  courseId   String
  userId     String?  // null pour les avis d'amorçage (apprenants fictifs vérifiés à la main)
  authorName String
  authorInitials String
  rating     Int      // 1..5
  title      String?
  body       String
  locale     String   @default("fr") // fr | en | ar
  featured   Boolean  @default(false)
  createdAt  DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([courseId])
  @@index([courseId, locale])
}

// ----- Échanges sous une leçon -----

// Commentaire public sous une leçon, lisible par tous ceux qui ont accès à la leçon.
// `hidden` : masqué par la modération, conservé pour trace.
model LessonComment {
  id         String   @id @default(cuid())
  lessonId   String
  userId     String
  authorName String
  body       String
  locale     String   @default("fr")
  hidden     Boolean  @default(false)
  createdAt  DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lessonId, createdAt])
  @@index([userId])
}

// Note privée : une seule par apprenant et par leçon, jamais affichée à un tiers.
model LessonNote {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  body      String
  updatedAt DateTime @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

// ----- Parcours : plusieurs cours enchaînés dans un ordre voulu -----

model LearningPath {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String
  description String
  // Traductions : { en: {title, summary, description}, ar: {...} }
  i18n        String?
  status      String   @default("PUBLISHED") // DRAFT | PUBLISHED
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses LearningPathCourse[]

  @@index([status])
}

model LearningPathCourse {
  id       String @id @default(cuid())
  pathId   String
  courseId String
  position Int    @default(0)

  path   LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  course Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([pathId, courseId])
  @@index([courseId])
}

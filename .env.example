# Copier en `.env` et remplir. AUCUNE vraie clé ici (placeholders uniquement).
# `.env` est gitignored ; ce fichier .env.example est commité comme documentation.

# ============================================================
#  BASE DE DONNÉES
# ============================================================
# Dev : SQLite (zéro setup). C'est la valeur par défaut.
DATABASE_URL="file:./dev.db"
# Prod : Postgres. Passer aussi provider="postgresql" dans prisma/schema.prisma.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/omnilearning?schema=public"

# ============================================================
#  AUTH.JS / NEXTAUTH (obligatoire)
# ============================================================
# Générer : openssl rand -base64 32
AUTH_SECRET=""
# Prod uniquement : URL publique canonique de l'app.
# AUTH_URL="https://omnilearning.tech"

# ------ OAuth Google (optionnel) ------
# Console : https://console.cloud.google.com -> Credentials -> OAuth client ID (Web)
# Redirect URI : <APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ------ OAuth GitHub (optionnel) ------
# https://github.com/settings/developers -> New OAuth App
# Callback URL : <APP_URL>/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ============================================================
#  STRIPE — abonnements (page "soutenir")
# ============================================================
# Dashboard Stripe -> Developers -> API keys
STRIPE_SECRET_KEY=""                       # sk_live_... (ou sk_test_... en test)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""      # pk_live_... (ou pk_test_...)
# Webhook : Dashboard -> Developers -> Webhooks -> endpoint <APP_URL>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=""                   # whsec_...
# Créer 3 prix récurrents mensuels (5/15/50 €) -> copier les price_id ici
STRIPE_PRICE_SOUTIEN=""                     # price_... (5 €/mois)
STRIPE_PRICE_MECENE=""                      # price_... (15 €/mois)
STRIPE_PRICE_PARTENAIRE=""                  # price_... (50 €/mois)

# ============================================================
#  UPLOADS
# ============================================================
# "local" (par défaut, écrit dans public/uploads) ou "s3".
UPLOAD_PROVIDER="local"
# Si UPLOAD_PROVIDER="s3" :
# AWS_S3_BUCKET=""
# AWS_S3_REGION=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# ============================================================
#  DIVERS
# ============================================================
NEXT_PUBLIC_APP_URL="http://localhost:3005"
